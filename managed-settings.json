{
  "env": {
    "DO_NOT_TRACK": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "allowManagedHooksOnly": true,
  "disableSideloadFlags": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "strictAllowlist": true,
      "allowManagedDomainsOnly": true,
      "allowedDomains": [
        "claude.ai",
        "*.claude.ai",
        "claude.com",
        "*.claude.com",
        "nordvpn.com",
        "api.nordvpn.com",
        "github.com",
        "*.github.com",
        "github.io",
        "*.github.io",
        "githubusercontent.com",
        "*.githubusercontent.com",
        "deb.debian.org",
        "security.debian.org",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "nodejs.org",
        "cmake.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "static.rust-lang.org",
        "proxy.golang.org",
        "sum.golang.org",
        "gitlab.com",
        "center.conan.io",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "ghcr.io",
        "quay.io",
        "*.quay.io",
        "rfc-editor.org",
        "www.rfc-editor.org",
        "httpwg.org",
        "datatracker.ietf.org",
        "developer.mozilla.org"
      ]
    }
  },
  "companyAnnouncements": [
    "Best AI companion evaaar!"
  ]
}
